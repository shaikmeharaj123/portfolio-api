# Google OAuth for Gmail Job Application Tracking
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/callback

# Use a long random secret; OAuth tokens are encrypted at rest with this value.
# If omitted, the API falls back to JWT_SECRET, but a dedicated key is recommended.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Admin URL used after OAuth callback
ADMIN_URL=http://localhost:5173
