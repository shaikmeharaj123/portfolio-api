# Google OAuth for Gmail Job Application Tracking
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/callback

# Use a long random secret; Gmail OAuth tokens are encrypted at rest with this value.
# If omitted, the API falls back to JWT_SECRET, but a dedicated key is recommended.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Optional comma-separated list of older encryption keys to try when reading
# existing Gmail tokens after a secret rotation.
GMAIL_TOKEN_LEGACY_ENCRYPTION_KEYS=

# Admin URL used after OAuth callback
ADMIN_URL=http://localhost:5173
